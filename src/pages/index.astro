---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import ContactButtons from '../components/ContactButtons.astro';
import TagBadge from '../components/TagBadge.astro';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts    = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = posts[0];
const rest     = posts.slice(1);
const allTags  = [...new Set(posts.flatMap(p => p.data.tags))].sort();
---

<BaseLayout title="Jafet Brito — Blog de Ciberseguridad">

  <!-- ── HERO ──────────────────────────────────────────────── -->
  <section class="bg-gradient-to-br from-white via-green-50/40 to-white
                  dark:from-terminal-bg dark:via-terminal-surface dark:to-terminal-bg
                  border-b border-gray-200 dark:border-terminal-border">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-10">

        <!-- Avatar -->
        <div class="flex-shrink-0">
          <div class="relative">
            <img
              src="https://avatars.githubusercontent.com/u/73570144?v=4"
              alt="Jafet Brito"
              width="160" height="160"
              class="w-36 h-36 sm:w-40 sm:h-40 rounded-2xl object-cover shadow-xl
                     ring-4 ring-green-200 dark:ring-terminal-green/30"
            />
            <span class="absolute -bottom-2 -right-2 bg-green-500 dark:bg-terminal-green
                         text-white dark:text-black text-xs font-bold font-mono
                         px-2 py-0.5 rounded-full shadow">
              root
            </span>
          </div>
        </div>

        <!-- Info -->
        <div class="text-center sm:text-left">
          <p data-t="hero.role" class="text-sm font-mono text-green-700 dark:text-terminal-green mb-2 tracking-widest uppercase">
            Security Researcher
          </p>
          <h1 class="font-display font-bold text-4xl sm:text-5xl text-gray-900 dark:text-zinc-50 mb-4 leading-tight">
            Jafet Brito
          </h1>
          <p data-t="hero.bio" class="text-lg text-gray-500 dark:text-zinc-400 leading-relaxed max-w-xl mb-6">
            Investigador en ciberseguridad. Escribo sobre seguridad ofensiva, CTFs,
            análisis de vulnerabilidades y técnicas de pentesting. Todo lo que aprendo, lo comparto aquí.
          </p>

          <div class="flex flex-wrap justify-center sm:justify-start gap-3 mb-6">
            {['web', 'reversing', 'ctf', 'linux', 'osint'].map(tag => (
              <TagBadge tag={tag} linked />
            ))}
          </div>

          <ContactButtons size="md" />
        </div>

      </div>
    </div>
  </section>

  <!-- ── STATS ─────────────────────────────────────────────── -->
  <section class="border-b border-gray-200 dark:border-terminal-border bg-white dark:bg-terminal-surface/20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-6">
      <div class="grid grid-cols-3 gap-4 sm:gap-8 text-center">
        {[
          { n: posts.length,   label: 'Posts publicados', tKey: 'hero.posts'  },
          { n: allTags.length, label: 'Categorías',       tKey: 'hero.cats'   },
          { n: '24/7',         label: 'Investigando',     tKey: 'hero.active' },
        ].map(({ n, label, tKey }) => (
          <div>
            <p class="font-display font-bold text-2xl sm:text-3xl text-green-700 dark:text-terminal-green">{n}</p>
            <p data-t={tKey} class="text-xs sm:text-sm text-gray-400 dark:text-zinc-500 mt-1">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── POSTS ─────────────────────────────────────────────── -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-12">

    <!-- Section header + live tag filter -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
      <h2 data-t="home.latest" class="font-display font-bold text-2xl text-gray-900 dark:text-zinc-50">
        Últimos posts
      </h2>
      <div id="tag-filters" class="flex flex-wrap gap-1.5">
        {allTags.map(tag => (
          <button
            type="button"
            data-filter-tag={tag}
            class="tag-filter-btn px-2.5 py-1 text-xs font-mono rounded-lg border
                   border-gray-200 dark:border-zinc-700
                   text-gray-500 dark:text-zinc-400
                   hover:border-green-500 hover:text-green-700
                   dark:hover:border-terminal-green dark:hover:text-terminal-green
                   transition-colors"
          >
            #{tag}
          </button>
        ))}
      </div>
    </div>

    <!-- Posts grid (all rendered; tag/search filter runs client-side) -->
    <div id="posts-container">
      {posts.length === 0 ? (
        <div class="text-center py-16 text-gray-400 dark:text-zinc-500">
          <p data-t="home.empty" class="text-lg font-mono">// sin posts todavía</p>
          <p class="text-sm mt-2 font-mono opacity-60">$ touch src/content/posts/primer-post.md</p>
        </div>
      ) : (
        <>
          {/* Featured post */}
          {featured && (
            <div class="mb-6" id="featured-wrapper">
              <PostCard post={featured} featured />
            </div>
          )}
          {/* Rest in grid */}
          {rest.length > 0 && (
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              {rest.map(post => <PostCard post={post} />)}
            </div>
          )}
        </>
      )}
    </div>

    <!-- Empty state when all filtered out -->
    <p id="no-posts-msg" class="hidden text-center py-12 text-gray-400 dark:text-zinc-500 font-mono text-sm">
      // sin resultados para este filtro
    </p>

  </section>

  <!-- ── CONTACT CTA ───────────────────────────────────────── -->
  <section class="border-t border-gray-200 dark:border-terminal-border
                  bg-gradient-to-br from-green-50 to-white
                  dark:from-terminal-surface/40 dark:to-terminal-bg">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-14 text-center">
      <h2 data-t="home.cta.title" class="font-display font-bold text-3xl text-gray-900 dark:text-zinc-50 mb-3">
        ¿Tienes alguna pregunta?
      </h2>
      <p data-t="home.cta.body" class="text-lg text-gray-500 dark:text-zinc-400 mb-8 max-w-xl mx-auto">
        Estoy disponible para consultas, colaboraciones o simplemente para hablar de seguridad.
      </p>
      <div class="flex justify-center">
        <ContactButtons size="lg" />
      </div>
    </div>
  </section>

</BaseLayout>

<script is:inline>
(function () {
  var activeTag = null;

  /* ── Tag filter ─────────────────────────────────────────── */
  document.querySelectorAll('.tag-filter-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var tag = this.getAttribute('data-filter-tag');
      if (activeTag === tag) {
        /* deselect */
        activeTag = null;
        document.querySelectorAll('.tag-filter-btn').forEach(function (b) {
          b.classList.remove('border-green-500', 'text-green-700',
                             'dark:border-terminal-green', 'dark:text-terminal-green');
          b.classList.add('border-gray-200', 'dark:border-zinc-700',
                          'text-gray-500', 'dark:text-zinc-400');
        });
      } else {
        activeTag = tag;
        document.querySelectorAll('.tag-filter-btn').forEach(function (b) {
          var isActive = b.getAttribute('data-filter-tag') === tag;
          b.classList.toggle('border-green-500',      isActive);
          b.classList.toggle('text-green-700',        isActive);
          b.classList.toggle('dark:border-terminal-green', isActive);
          b.classList.toggle('dark:text-terminal-green',   isActive);
          b.classList.toggle('border-gray-200',      !isActive);
          b.classList.toggle('dark:border-zinc-700', !isActive);
          b.classList.toggle('text-gray-500',        !isActive);
          b.classList.toggle('dark:text-zinc-400',   !isActive);
        });
      }
      applyFilter();
    });
  });

  function applyFilter() {
    var cards     = document.querySelectorAll('article[data-post-tags]');
    var noMsg     = document.getElementById('no-posts-msg');
    var featured  = document.getElementById('featured-wrapper');
    var visible   = 0;

    cards.forEach(function (el) {
      var tags   = (el.getAttribute('data-post-tags') || '').split(',');
      var show   = !activeTag || tags.includes(activeTag);
      el.style.display = show ? '' : 'none';
      if (show) visible++;
      /* hide featured wrapper when its card is hidden */
      if (featured && featured.contains(el)) {
        featured.style.display = show ? '' : 'none';
      }
    });

    if (noMsg) noMsg.classList.toggle('hidden', visible > 0);
  }
})();
</script>
