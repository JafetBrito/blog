---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts    = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Build a plain-text search index of each post's body (ES + EN content)
// so the search can find and show *where* a term appears, not just
// whether it's in the title/description.
function stripMarkdown(md: string): string {
  return md
    .replace(/```[\s\S]*?```/g, ' ')            // code blocks
    .replace(/<[^>]+>/g, ' ')                   // html tags (e.g. <div class="lang-es">)
    .replace(/!\[.*?\]\(.*?\)/g, ' ')           // images
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')    // [text](url) -> text
    .replace(/[#>*_~`|-]/g, ' ')                // markdown punctuation
    .replace(/\s+/g, ' ')
    .trim();
}

const searchIndex = posts.map(post => ({
  slug: post.slug,
  text: stripMarkdown(post.body ?? ''),
}));

// Escape "</" so the JSON can't break out of the <script> tag
const searchIndexJson = JSON.stringify(searchIndex).replace(/</g, '\\u003c');
---

<BaseLayout title="Buscar — Jafet Brito" description="Busca posts en el blog de Jafet Brito">

  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12">

    <!-- Header -->
    <div class="mb-8">
      <h1 data-t="search.title" class="font-display font-bold text-3xl text-gray-900 dark:text-zinc-50 mb-6">
        Buscar
      </h1>

      <!-- Search input -->
      <div class="relative">
        <div class="absolute inset-y-0 left-4 flex items-center pointer-events-none">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
               class="w-5 h-5 text-gray-400 dark:text-zinc-500">
            <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd"/>
          </svg>
        </div>
        <input
          id="search-input"
          type="search"
          autofocus
          data-t-placeholder="search.placeholder"
          placeholder="Buscar posts..."
          class="w-full pl-12 pr-5 py-4 rounded-2xl border-2 border-gray-200 dark:border-zinc-700
                 bg-white dark:bg-zinc-900 text-gray-900 dark:text-zinc-100
                 font-sans text-lg placeholder:text-gray-400 dark:placeholder:text-zinc-600
                 focus:outline-none focus:border-green-500 dark:focus:border-terminal-green
                 transition-colors shadow-sm"
        />
      </div>

      <!-- Result count -->
      <p id="result-count" class="mt-3 text-sm text-gray-400 dark:text-zinc-500 font-mono hidden">
        <span id="count-num">0</span> resultado(s)
      </p>
    </div>

    <!-- Posts list -->
    <div id="results" class="grid grid-cols-1 gap-5">
      {posts.map(post => (
        <div class="search-result-item" data-slug={post.slug}>
          <PostCard post={post} />
          <p class="search-snippet hidden mt-2 px-2 text-sm text-gray-500 dark:text-zinc-400 font-mono leading-relaxed"></p>
        </div>
      ))}
    </div>

    <!-- Empty state -->
    <div id="no-results" class="hidden text-center py-20">
      <p data-t="search.empty" class="text-2xl font-mono text-gray-400 dark:text-zinc-500 mb-3">
        // sin resultados
      </p>
      <a href="/" data-t="search.all" class="text-sm text-green-700 dark:text-terminal-green hover:underline font-mono">
        Ver todos los posts →
      </a>
    </div>

  </div>

  <script type="application/json" id="search-index" set:html={searchIndexJson} />

</BaseLayout>

<script is:inline>
(function () {
  var input    = document.getElementById('search-input');
  var noRes    = document.getElementById('no-results');
  var countEl  = document.getElementById('result-count');
  var countNum = document.getElementById('count-num');
  var indexEl  = document.getElementById('search-index');

  /* slug -> plain-text body content, for snippet matching */
  var bodyBySlug = {};
  try {
    var raw = JSON.parse((indexEl && indexEl.textContent) || '[]');
    raw.forEach(function (item) { bodyBySlug[item.slug] = item.text; });
  } catch (e) {}

  function escapeHtml(str) {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  function escapeRegExp(str) {
    return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }

  /* Build a highlighted snippet of `text` around the first match of `q` */
  function buildSnippet(text, q) {
    var lower = text.toLowerCase();
    var idx = lower.indexOf(q);
    if (idx === -1) return '';

    var radius = 70;
    var start  = Math.max(0, idx - radius);
    var end    = Math.min(text.length, idx + q.length + radius);

    var snippet = escapeHtml(text.slice(start, end));
    if (start > 0) snippet = '… ' + snippet;
    if (end < text.length) snippet = snippet + ' …';

    var re = new RegExp('(' + escapeRegExp(q) + ')', 'ig');
    snippet = snippet.replace(re, '<mark class="bg-yellow-200 dark:bg-terminal-green/30 text-gray-900 dark:text-zinc-50 rounded px-0.5">$1</mark>');

    return snippet;
  }

  function runSearch() {
    var q     = (input.value || '').toLowerCase().trim();
    var items = document.querySelectorAll('.search-result-item');
    var shown = 0;

    items.forEach(function (item) {
      var article    = item.querySelector('article[data-search-text]');
      var snippetEl  = item.querySelector('.search-snippet');
      var titleText  = (article && article.getAttribute('data-search-text')) || '';
      var bodyText   = bodyBySlug[item.getAttribute('data-slug')] || '';

      var titleMatch = !!q && titleText.includes(q);
      var bodySnippet = q ? buildSnippet(bodyText, q) : '';
      var bodyMatch  = !!bodySnippet;

      var show = !q || titleMatch || bodyMatch;
      item.style.display = show ? '' : 'none';

      if (snippetEl) {
        if (q && bodyMatch) {
          snippetEl.innerHTML = '🔎 ' + bodySnippet;
          snippetEl.classList.remove('hidden');
        } else {
          snippetEl.innerHTML = '';
          snippetEl.classList.add('hidden');
        }
      }

      if (show) shown++;
    });

    if (noRes)    noRes.classList.toggle('hidden', !q || shown > 0);
    if (countEl)  countEl.classList.toggle('hidden', !q);
    if (countNum) countNum.textContent = String(shown);
  }

  if (input) {
    input.addEventListener('input', runSearch);
    /* If navigated with a ?q= param, pre-fill */
    var params = new URLSearchParams(window.location.search);
    var q0 = params.get('q');
    if (q0) { input.value = q0; runSearch(); }
  }
})();
</script>
