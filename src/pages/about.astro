---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactButtons from '../components/ContactButtons.astro';
import TagBadge from '../components/TagBadge.astro';

const skills = [
  { cat: 'Ofensiva',     catKey: 'about.skills.cat.1', items: [
    { text: 'Pentesting Web' },
    { text: 'Explotación de binarios', tKey: 'about.skill.binex'    },
    { text: 'Ingeniería inversa',      tKey: 'about.skill.re'       },
    { text: 'Red Teaming' },
  ]},
  { cat: 'Análisis',     catKey: 'about.skills.cat.2', items: [
    { text: 'Análisis de malware', tKey: 'about.skill.malware'   },
    { text: 'Forense digital',     tKey: 'about.skill.forensics' },
    { text: 'OSINT' },
    { text: 'Threat intelligence' },
  ]},
  { cat: 'Plataformas',  catKey: 'about.skills.cat.3', items: [
    { text: 'HackTheBox' },
    { text: 'TryHackMe'  },
    { text: 'PicoCTF'    },
    { text: 'VulnHub'    },
  ]},
  { cat: 'Herramientas', catKey: 'about.skills.cat.4', items: [
    { text: 'Burp Suite'  },
    { text: 'Metasploit'  },
    { text: 'Ghidra'      },
    { text: 'Wireshark'   },
    { text: 'nmap'        },
    { text: 'gdb/pwndbg'  },
  ]},
];
---

<BaseLayout title="Sobre mí — Jafet Brito" description="Investigador en ciberseguridad. Conoce más sobre Jafet Brito.">

  <!-- Hero -->
  <section class="bg-gradient-to-br from-white via-green-50/30 to-white
                  dark:from-terminal-bg dark:via-terminal-surface dark:to-terminal-bg
                  border-b border-gray-200 dark:border-terminal-border py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="flex flex-col sm:flex-row items-center gap-10">

        <div class="flex-shrink-0">
          <img
            src={`${import.meta.env.BASE_URL}media/k.png`}
            alt="Jafet Brito"
            width="200" height="200"
            class="w-44 h-44 rounded-2xl object-cover shadow-2xl
                   ring-4 ring-green-200 dark:ring-terminal-green/30"
          />
        </div>

        <div class="text-center sm:text-left">
          <p class="text-sm font-mono text-green-700 dark:text-terminal-green mb-2 tracking-widest uppercase">whoami</p>
          <h1 class="font-display font-bold text-4xl text-gray-900 dark:text-zinc-50 mb-4">Jafet Brito</h1>
          <p data-t="about.subtitle" class="text-xl text-gray-500 dark:text-zinc-400 mb-2 font-mono">Security Researcher · CTF Player</p>
          <p data-t="about.bio.short" class="text-base text-gray-500 dark:text-zinc-400 max-w-lg leading-relaxed">
            Apasionado por encontrar vulnerabilidades antes que los atacantes.
            Llevo años estudiando seguridad ofensiva de forma autodidacta,
            participando en CTFs internacionales y analizando malware en mi laboratorio.
          </p>
        </div>

      </div>
    </div>
  </section>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 space-y-14">

    <!-- Bio -->
    <section>
      <h2 class="font-display font-bold text-2xl text-gray-900 dark:text-zinc-50 mb-6 flex items-center gap-3">
        <span class="w-1 h-7 bg-green-500 dark:bg-terminal-green rounded-full inline-block"></span>
        <span data-t="about.bio.title">Mi historia</span>
      </h2>
      <div class="prose prose-gray prose-lg max-w-none dark:prose-invert">
        <p data-th="about.bio.p1">
          Empecé en la informática desarmando aparatos para ver cómo funcionaban por dentro.
          Esa misma curiosidad me llevó a la ciberseguridad: necesito entender
          <strong>exactamente</strong> cómo funciona algo para saber cómo romperlo.
        </p>
        <p data-t="about.bio.p2">
          Este blog es mi cuaderno de notas público. Aquí documento lo que aprendo —
          técnicas de pentesting, writeups de CTFs, análisis de vulnerabilidades reales —
          porque enseñar es la mejor forma de aprender.
        </p>
        <p data-t="about.bio.p3">
          Todo el contenido es con fines educativos y de investigación.
          Creo firmemente en la divulgación responsable y en usar el conocimiento
          de seguridad para proteger sistemas, no para dañarlos.
        </p>
      </div>
    </section>

    <!-- Skills grid -->
    <section>
      <h2 class="font-display font-bold text-2xl text-gray-900 dark:text-zinc-50 mb-6 flex items-center gap-3">
        <span class="w-1 h-7 bg-green-500 dark:bg-terminal-green rounded-full inline-block"></span>
        <span data-t="about.skills.title">Especialidades</span>
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        {skills.map(({ cat, catKey, items }) => (
          <div class="bg-white dark:bg-zinc-900/60 border border-gray-200 dark:border-zinc-800 rounded-xl p-5 shadow-sm">
            <h3 data-t={catKey} class="font-display font-semibold text-green-700 dark:text-terminal-green mb-3 text-sm uppercase tracking-wide">
              {cat}
            </h3>
            <ul class="space-y-1.5">
              {items.map(item => (
                <li class="flex items-center gap-2 text-gray-600 dark:text-zinc-300 text-sm">
                  <span class="w-1.5 h-1.5 rounded-full bg-green-500 dark:bg-terminal-green-dim flex-shrink-0"></span>
                  {item.tKey
                    ? <span data-t={item.tKey}>{item.text}</span>
                    : item.text
                  }
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Tags de contenido -->
    <section>
      <h2 class="font-display font-bold text-2xl text-gray-900 dark:text-zinc-50 mb-6 flex items-center gap-3">
        <span class="w-1 h-7 bg-green-500 dark:bg-terminal-green rounded-full inline-block"></span>
        <span data-t="about.topics">Temas del blog</span>
      </h2>
      <div class="flex flex-wrap gap-2">
        {['web', 'reversing', 'ctf', 'osint', 'malware', 'network', 'linux', 'exploit', 'forense'].map(tag => (
          <TagBadge tag={tag} linked />
        ))}
      </div>
    </section>

    <!-- Setup section with image -->
    <section>
      <h2 class="font-display font-bold text-2xl text-gray-900 dark:text-zinc-50 mb-6 flex items-center gap-3">
        <span class="w-1 h-7 bg-green-500 dark:bg-terminal-green rounded-full inline-block"></span>
        <span data-t="about.setup">Mi setup</span>
      </h2>
      <div class="relative rounded-2xl overflow-hidden shadow-xl mb-5">
        <img
          src="https://picsum.photos/seed/hacking-setup/1200/500"
          alt="Setup de trabajo"
          width="1200" height="500"
          loading="lazy"
          class="w-full object-cover max-h-72"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex items-end p-6">
          <p class="font-mono text-white text-sm">
            <span class="text-green-400">$</span> uname -a · Kali Linux 6.6 · VMs: Windows / Windows Server
          </p>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section class="bg-gradient-to-br from-green-50 to-white dark:from-terminal-surface/40 dark:to-terminal-bg
                    border border-green-200 dark:border-terminal-green/20 rounded-2xl p-8 text-center">
      <h2 data-t="about.cta.title" class="font-display font-bold text-2xl text-gray-900 dark:text-zinc-50 mb-3">Hablemos</h2>
      <p data-t="about.cta.body" class="text-gray-500 dark:text-zinc-400 mb-6 max-w-md mx-auto">
        Disponible para consultas de seguridad, proyectos de pentesting
        o simplemente para intercambiar ideas sobre CTFs.
      </p>
      <div class="flex justify-center">
        <ContactButtons size="lg" />
      </div>
    </section>

  </div>
</BaseLayout>
