---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title:        string;
  description?: string;
  heroImage?:   string;
}

const {
  title,
  description = 'Blog de ciberseguridad por Jafet Brito — writeups, análisis y técnicas de seguridad ofensiva.',
  heroImage,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://localhost:4321');
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots"      content="index, follow" />
    <meta name="author"      content="Jafet Brito" />
    <link rel="canonical"    href={canonicalURL} />

    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalURL} />
    {heroImage && <meta property="og:image" content={heroImage} />}

    <meta name="twitter:card"        content={heroImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    {heroImage && <meta name="twitter:image" content={heroImage} />}

    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5501225442342959" crossorigin="anonymous"></script>

    <!--
      ① Tema  — Por defecto SIEMPRE light.
                Solo dark si el usuario lo guardó explícitamente.
      ② Idioma — Por defecto español. Cambia con el toggle del header.
      ③ Traducciones — Se aplican tras el DOM, antes del primer frame.
    -->
    <script is:inline>
    (function () {
      /* ── tema ─────────────────────────────────────────── */
      try {
        if (localStorage.getItem('theme') === 'dark') {
          document.documentElement.classList.add('dark');
        }
        /* el <html lang> lo fijamos también aquí */
        var lang = localStorage.getItem('lang') || 'es';
        document.documentElement.lang = lang;
        window.__lang = lang;
      } catch (e) {
        window.__lang = 'es';
      }

      /* ── traducciones ──────────────────────────────────── */
      window.__ui = {
        es: {
          /* nav */
          'nav.home':   'Inicio',
          'nav.tags':   'Tags',
          'nav.about':  'Sobre mí',
          'nav.guide':  'Guía',
          /* hero */
          'hero.role':  'Security Researcher',
          'hero.bio':   'Investigador en ciberseguridad. Escribo sobre seguridad ofensiva, CTFs, análisis de vulnerabilidades y técnicas de pentesting. Todo lo que aprendo, lo comparto aquí.',
          'hero.posts': 'Posts publicados',
          'hero.cats':  'Categorías',
          'hero.active':'Investigando',
          /* home */
          'home.latest':    'Últimos posts',
          'home.cta.title': '¿Tienes alguna pregunta?',
          'home.cta.body':  'Estoy disponible para consultas, colaboraciones o simplemente para hablar de seguridad.',
          /* posts */
          'post.readmore': 'Leer más',
          'post.minread':  'min de lectura',
          'post.back':     'Volver al inicio',
          'post.author.cta': '¿Tienes preguntas sobre este post? Escríbeme.',
          /* footer */
          'footer.desc':    'Investigador en ciberseguridad. Compartiendo conocimiento sobre seguridad ofensiva, CTFs y análisis de vulnerabilidades.',
          'footer.nav':     'Navegación',
          'footer.contact': 'Contacto',
          'footer.reply':   'Respondo en menos de 48h',
          /* tags */
          'tags.title':  'Categorías',
          'tags.sub':    'Filtra los posts por tema de seguridad.',
          'tags.back':   'Todas las categorías',
          'tags.posts':  'post',
          'tags.postsp': 'posts',
          /* about */
          'about.subtitle':  'Security Researcher · CTF Player',
          'about.bio.short': 'Apasionado por encontrar vulnerabilidades antes que los atacantes. Llevo años estudiando seguridad ofensiva de forma autodidacta, participando en CTFs internacionales y analizando malware en mi laboratorio.',
          'about.bio.title': 'Mi historia',
          'about.bio.p1':    'Empecé en la informática desarmando aparatos para ver cómo funcionaban por dentro. Esa misma curiosidad me llevó a la ciberseguridad: necesito entender <strong>exactamente</strong> cómo funciona algo para saber cómo romperlo.',
          'about.bio.p2':    'Este blog es mi cuaderno de notas público. Aquí documento lo que aprendo — técnicas de pentesting, writeups de CTFs, análisis de vulnerabilidades reales — porque enseñar es la mejor forma de aprender.',
          'about.bio.p3':    'Todo el contenido es con fines educativos y de investigación. Creo firmemente en la divulgación responsable y en usar el conocimiento de seguridad para proteger sistemas, no para dañarlos.',
          'about.skills.title': 'Especialidades',
          'about.skills.cat.1': 'Ofensiva',
          'about.skills.cat.2': 'Análisis',
          'about.skills.cat.3': 'Plataformas',
          'about.skills.cat.4': 'Herramientas',
          'about.topics': 'Temas del blog',
          'about.setup':  'Mi setup',
          'about.cta.title': 'Hablemos',
          'about.cta.body': 'Disponible para consultas de seguridad, proyectos de pentesting o simplemente para intercambiar ideas sobre CTFs.',
          /* home empty state */
          'home.empty': '// sin posts todavía',
          /* post breadcrumb */
          'post.breadcrumb.home':  'Inicio',
          'post.breadcrumb.posts': 'Posts',
          /* buttons */
          'btn.email':    'Email',
          'btn.telegram': 'Telegram',
          /* guide */
          'guide.title': 'Guía del blog',
        },
        en: {
          'nav.home':   'Home',
          'nav.tags':   'Tags',
          'nav.about':  'About',
          'nav.guide':  'Guide',
          'hero.role':  'Security Researcher',
          'hero.bio':   'Cybersecurity researcher. I write about offensive security, CTFs, vulnerability analysis and pentesting techniques. Everything I learn, I share here.',
          'hero.posts': 'Published posts',
          'hero.cats':  'Categories',
          'hero.active':'Researching',
          'home.latest':    'Latest posts',
          'home.cta.title': 'Have a question?',
          'home.cta.body':  'Available for security consultations, collaborations, or just to talk about security.',
          'post.readmore': 'Read more',
          'post.minread':  'min read',
          'post.back':     'Back to home',
          'post.author.cta': 'Have questions about this post? Write to me.',
          'footer.desc':    'Cybersecurity researcher. Sharing knowledge on offensive security, CTFs and vulnerability analysis.',
          'footer.nav':     'Navigation',
          'footer.contact': 'Contact',
          'footer.reply':   'I respond within 48h',
          'tags.title':  'Categories',
          'tags.sub':    'Filter posts by security topic.',
          'tags.back':   'All categories',
          'tags.posts':  'post',
          'tags.postsp': 'posts',
          'about.subtitle':  'Security Researcher · CTF Player',
          'about.bio.short': 'Passionate about finding vulnerabilities before attackers do. I\'ve spent years studying offensive security self-taught, competing in international CTFs and analyzing malware in my home lab.',
          'about.bio.title': 'My story',
          'about.bio.p1':    'I started in computing by taking devices apart to see how they worked inside. That same curiosity led me to cybersecurity: I need to understand <strong>exactly</strong> how something works to know how to break it.',
          'about.bio.p2':    'This blog is my public notebook. Here I document what I learn — pentesting techniques, CTF writeups, real vulnerability analysis — because teaching is the best way to learn.',
          'about.bio.p3':    'All content is for educational and research purposes. I firmly believe in responsible disclosure and using security knowledge to protect systems, not harm them.',
          'about.skills.title': 'Specialties',
          'about.skills.cat.1': 'Offensive',
          'about.skills.cat.2': 'Analysis',
          'about.skills.cat.3': 'Platforms',
          'about.skills.cat.4': 'Tools',
          'about.topics': 'Blog topics',
          'about.setup':  'My setup',
          'about.cta.title': "Let's talk",
          'about.cta.body': 'Available for security consulting, pentesting projects, or just to exchange ideas about CTFs.',
          'home.empty': '// no posts yet',
          'post.breadcrumb.home':  'Home',
          'post.breadcrumb.posts': 'Posts',
          'btn.email':    'Email',
          'btn.telegram': 'Telegram',
          'guide.title': 'Blog guide',
        }
      };

      /* Aplica traducciones a todos los [data-t] y [data-th] elementos */
      function applyTranslations() {
        var lang = window.__lang || 'es';
        var dict = window.__ui[lang] || window.__ui['es'];
        /* data-t  → textContent (seguro, sin HTML) */
        document.querySelectorAll('[data-t]').forEach(function (el) {
          var key = el.getAttribute('data-t');
          if (dict[key] !== undefined) el.textContent = dict[key];
        });
        /* data-th → innerHTML (para traducciones con <strong>, <em>, etc.) */
        document.querySelectorAll('[data-th]').forEach(function (el) {
          var key = el.getAttribute('data-th');
          if (dict[key] !== undefined) el.innerHTML = dict[key];
        });
        /* actualizar atributos aria/title */
        document.querySelectorAll('[data-t-title]').forEach(function (el) {
          var key = el.getAttribute('data-t-title');
          if (dict[key] !== undefined) el.setAttribute('title', dict[key]);
        });
      }

      /* Ejecutar lo antes posible */
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', applyTranslations);
      } else {
        applyTranslations();
      }
      window.__applyTranslations = applyTranslations;
    })();
    </script>
  </head>

  <body class="
    bg-white              text-gray-900
    dark:bg-terminal-bg   dark:text-zinc-100
    font-sans min-h-screen flex flex-col
    selection:bg-green-200 selection:text-green-900
    dark:selection:bg-terminal-green dark:selection:text-black
    antialiased transition-colors duration-200
  ">

    <!-- Dark-mode CRT scan line -->
    <div aria-hidden="true" class="fixed inset-x-0 top-0 pointer-events-none z-50 h-screen overflow-hidden hidden dark:block">
      <div class="absolute left-0 right-0 h-px bg-gradient-to-r from-transparent via-terminal-green/10 to-transparent animate-scan-line"></div>
    </div>

    <!-- Dark-mode vignette -->
    <div aria-hidden="true" class="fixed inset-0 pointer-events-none z-40 hidden dark:block bg-[radial-gradient(ellipse_80%_80%_at_50%_50%,transparent_55%,rgba(0,0,0,0.45)_100%)]"></div>

    <Header />

    <main class="flex-1 w-full animate-fade-in">
      <slot />
    </main>

    <Footer />
  </body>
</html>
