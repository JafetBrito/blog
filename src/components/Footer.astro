---
import ContactButtons from './ContactButtons.astro';
const year = new Date().getFullYear();
---

<footer class="border-t border-gray-200 dark:border-terminal-border mt-20
               bg-gray-50 dark:bg-terminal-surface/30">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10">

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 mb-8">

      <!-- Brand -->
      <div>
        <div class="flex items-center gap-2 mb-3">
          <div class="w-8 h-8 rounded-lg bg-green-600 dark:bg-terminal-green flex items-center justify-center">
            <span class="text-white dark:text-black font-bold font-mono text-sm">JB</span>
          </div>
          <span class="font-display font-semibold text-gray-900 dark:text-zinc-100">Jafet Brito</span>
        </div>
        <p data-t="footer.desc" class="text-sm text-gray-500 dark:text-zinc-400 leading-relaxed">
          Investigador en ciberseguridad. Compartiendo conocimiento sobre seguridad ofensiva, CTFs y análisis de vulnerabilidades.
        </p>
      </div>

      <!-- Nav links -->
      <div>
        <h3 data-t="footer.nav" class="text-sm font-semibold text-gray-900 dark:text-zinc-100 mb-3">Navegación</h3>
        <ul class="space-y-2">
          <li><a data-t="nav.home"  href="/"      class="text-sm text-gray-500 dark:text-zinc-400 hover:text-green-700 dark:hover:text-terminal-green transition-colors">Inicio</a></li>
          <li><a data-t="nav.tags"  href="/tags"  class="text-sm text-gray-500 dark:text-zinc-400 hover:text-green-700 dark:hover:text-terminal-green transition-colors">Tags</a></li>
          <li><a data-t="nav.about" href="/about" class="text-sm text-gray-500 dark:text-zinc-400 hover:text-green-700 dark:hover:text-terminal-green transition-colors">Sobre mí</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 data-t="footer.contact" class="text-sm font-semibold text-gray-900 dark:text-zinc-100 mb-3">Contacto</h3>
        <ContactButtons size="sm" variant="outline" />
        <p data-t="footer.reply" class="text-xs text-gray-400 dark:text-zinc-500 mt-3">Respondo en menos de 48h</p>
      </div>

    </div>

    <div class="pt-6 border-t border-gray-200 dark:border-terminal-border flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 text-xs text-gray-400 dark:text-zinc-500">
      <span>© {year} Jafet Brito</span>
      <span class="flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-green-500 dark:bg-terminal-green animate-blink inline-block"></span>
        Astro + Tailwind CSS
      </span>
    </div>

  </div>
</footer>
