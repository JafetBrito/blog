---
interface Props {
  email?:    string;
  telegram?: string;
  size?:     'sm' | 'md' | 'lg';
  variant?:  'solid' | 'outline';
}

const {
  email    = 'hola@jafetbrito.com',
  telegram = 'jafetbrito',
  size     = 'md',
  variant  = 'solid',
} = Astro.props;

const sz = {
  sm:  'px-3.5 py-1.5 text-sm gap-1.5',
  md:  'px-5 py-2.5 text-base gap-2',
  lg:  'px-6 py-3 text-lg gap-2.5',
}[size];

const solidEmail = `inline-flex items-center font-semibold rounded-lg transition-all duration-200 shadow-sm
  bg-green-600 hover:bg-green-700 text-white
  dark:bg-terminal-green dark:hover:bg-terminal-green-dim dark:text-black ${sz}`;

const outlineEmail = `inline-flex items-center font-semibold rounded-lg transition-all duration-200
  border-2 border-green-600 hover:bg-green-600 text-green-700 hover:text-white
  dark:border-terminal-green dark:hover:bg-terminal-green dark:text-terminal-green dark:hover:text-black ${sz}`;

const solidTelegram = `inline-flex items-center font-semibold rounded-lg transition-all duration-200 shadow-sm
  bg-sky-500 hover:bg-sky-600 text-white
  dark:bg-sky-600 dark:hover:bg-sky-700 ${sz}`;

const outlineTelegram = `inline-flex items-center font-semibold rounded-lg transition-all duration-200
  border-2 border-sky-500 hover:bg-sky-500 text-sky-600 hover:text-white
  dark:border-sky-500 dark:hover:bg-sky-500 dark:text-sky-400 dark:hover:text-white ${sz}`;

const emailCls    = variant === 'solid' ? solidEmail    : outlineEmail;
const telegramCls = variant === 'solid' ? solidTelegram : outlineTelegram;
---

<div class="flex flex-wrap items-center gap-3">
  <a href={`mailto:${email}`} class={emailCls}>
    <!-- Mail icon -->
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 flex-shrink-0">
      <path d="M3 4a2 2 0 00-2 2v1.161l8.441 4.221a1.25 1.25 0 001.118 0L19 7.162V6a2 2 0 00-2-2H3z"/>
      <path d="M19 8.839l-7.77 3.885a2.75 2.75 0 01-2.46 0L1 8.839V14a2 2 0 002 2h14a2 2 0 002-2V8.839z"/>
    </svg>
    Email
  </a>

  <a href={`https://t.me/${telegram}`} target="_blank" rel="noopener noreferrer" class={telegramCls}>
    <!-- Telegram icon -->
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 flex-shrink-0">
      <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
    </svg>
    Telegram
  </a>
</div>
