---
const nav = [
  { key: 'nav.home',  href: '/',      labelEs: 'Inicio'   },
  { key: 'nav.tags',  href: '/tags',  labelEs: 'Tags'     },
  { key: 'nav.about', href: '/about', labelEs: 'Sobre mí' },
];

const rawPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-30
  bg-white/90 dark:bg-terminal-bg/95
  border-b border-gray-200 dark:border-terminal-border
  backdrop-blur-md shadow-sm dark:shadow-none
  transition-colors duration-200">

  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-14 gap-4">

      <!-- Brand -->
      <a href="/" class="group flex items-center gap-2 flex-shrink-0">
        <div class="w-8 h-8 rounded-lg bg-green-600 dark:bg-terminal-green flex items-center justify-center flex-shrink-0 transition-colors duration-200">
          <span class="text-white dark:text-black font-bold font-mono text-sm leading-none">JB</span>
        </div>
        <div class="hidden sm:block">
          <span class="font-display font-semibold text-base text-gray-900 dark:text-zinc-100 group-hover:text-green-700 dark:group-hover:text-terminal-green transition-colors leading-none">
            Jafet Brito
          </span>
          <span class="block text-[11px] text-gray-400 dark:text-zinc-500 leading-none mt-0.5 font-mono">
            security researcher
          </span>
        </div>
      </a>

      <!-- Nav -->
      <nav aria-label="Navegación" class="flex items-center gap-1">
        {nav.map(({ key, href, labelEs }) => (
          <a
            href={href}
            data-t={key}
            class:list={[
              'px-3 py-1.5 rounded-md text-sm font-medium transition-colors duration-150',
              rawPath === href || (href !== '/' && rawPath.startsWith(href))
                ? 'bg-green-50 text-green-700 dark:bg-terminal-green/10 dark:text-terminal-green'
                : 'text-gray-600 hover:text-gray-900 hover:bg-gray-100 dark:text-zinc-400 dark:hover:text-zinc-100 dark:hover:bg-zinc-800/60',
            ]}
          >
            {labelEs}
          </a>
        ))}
      </nav>

      <!-- Right: search + contact + lang + theme -->
      <div class="flex items-center gap-1 flex-shrink-0">

        <!-- Search -->
        <a href="/search"
           class="p-2 rounded-lg text-gray-400 hover:text-green-700 hover:bg-green-50 dark:text-zinc-500 dark:hover:text-terminal-green dark:hover:bg-terminal-green/10 transition-colors"
           title="Buscar">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5">
            <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd"/>
          </svg>
        </a>

        <div class="hidden md:block w-px h-5 bg-gray-200 dark:bg-zinc-700 mx-1"></div>

        <!-- Email -->
        <a href="mailto:hola@jafetbrito.com"
           class="p-2 rounded-lg text-gray-400 hover:text-green-700 hover:bg-green-50 dark:text-zinc-500 dark:hover:text-terminal-green dark:hover:bg-terminal-green/10 transition-colors hidden md:flex"
           title="Email">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5">
            <path d="M3 4a2 2 0 00-2 2v1.161l8.441 4.221a1.25 1.25 0 001.118 0L19 7.162V6a2 2 0 00-2-2H3z"/>
            <path d="M19 8.839l-7.77 3.885a2.75 2.75 0 01-2.46 0L1 8.839V14a2 2 0 002 2h14a2 2 0 002-2V8.839z"/>
          </svg>
        </a>

        <!-- Telegram -->
        <a href="https://t.me/jafetbrito" target="_blank" rel="noopener noreferrer"
           class="p-2 rounded-lg text-gray-400 hover:text-sky-600 hover:bg-sky-50 dark:text-zinc-500 dark:hover:text-sky-400 dark:hover:bg-sky-500/10 transition-colors hidden md:flex"
           title="Telegram">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
            <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
          </svg>
        </a>

        <div class="hidden md:block w-px h-5 bg-gray-200 dark:bg-zinc-700 mx-1"></div>

        <!-- Language toggle -->
        <button
          id="lang-toggle"
          type="button"
          aria-label="Cambiar idioma / Switch language"
          class="flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-xs font-semibold font-mono
                 border border-gray-200 dark:border-zinc-700
                 text-gray-500 dark:text-zinc-400
                 hover:border-green-500 hover:text-green-700
                 dark:hover:border-terminal-green dark:hover:text-terminal-green
                 transition-colors duration-150"
        >
          <span id="lang-label">ES</span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5">
            <path fill-rule="evenodd" d="M10 3a.75.75 0 01.55.24l3.25 3.5a.75.75 0 11-1.1 1.02L10 4.852 7.3 7.76a.75.75 0 01-1.1-1.02l3.25-3.5A.75.75 0 0110 3zm-3.76 9.2a.75.75 0 011.06.04l2.7 2.908 2.7-2.908a.75.75 0 111.1 1.02l-3.25 3.5a.75.75 0 01-1.1 0l-3.25-3.5a.75.75 0 01.04-1.06z" clip-rule="evenodd"/>
          </svg>
        </button>

        <div class="w-px h-5 bg-gray-200 dark:bg-zinc-700 mx-1"></div>

        <!-- Theme toggle -->
        <button
          id="theme-toggle"
          type="button"
          aria-label="Cambiar tema claro/oscuro"
          class="p-2 rounded-lg text-gray-400 hover:text-gray-700 hover:bg-gray-100 dark:text-zinc-400 dark:hover:text-zinc-100 dark:hover:bg-zinc-800 transition-colors duration-150"
        >
          <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 hidden dark:block">
            <path d="M12 2.25a.75.75 0 01.75.75v2.25a.75.75 0 01-1.5 0V3a.75.75 0 01.75-.75zM7.5 12a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM18.894 6.166a.75.75 0 00-1.06-1.06l-1.591 1.59a.75.75 0 101.06 1.061l1.591-1.59zM21.75 12a.75.75 0 01-.75.75h-2.25a.75.75 0 010-1.5H21a.75.75 0 01.75.75zM17.834 18.894a.75.75 0 001.06-1.06l-1.59-1.591a.75.75 0 10-1.061 1.06l1.59 1.591zM12 18a.75.75 0 01.75.75V21a.75.75 0 01-1.5 0v-2.25A.75.75 0 0112 18zM7.166 17.834a.75.75 0 00-1.06 1.06l1.59 1.591a.75.75 0 001.061-1.06l-1.59-1.591zM6 12a.75.75 0 01-.75.75H3a.75.75 0 010-1.5h2.25A.75.75 0 016 12zM6.166 6.166a.75.75 0 001.06 1.06l1.59-1.59a.75.75 0 10-1.06-1.061L6.166 6.166z"/>
          </svg>
          <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 block dark:hidden">
            <path fill-rule="evenodd" d="M9.528 1.718a.75.75 0 01.162.819A8.97 8.97 0 009 6a9 9 0 009 9 8.97 8.97 0 003.463-.69.75.75 0 01.981.98 10.503 10.503 0 01-9.694 6.46c-5.799 0-10.5-4.701-10.5-10.5 0-4.368 2.667-8.112 6.46-9.694a.75.75 0 01.818.162z" clip-rule="evenodd"/>
          </svg>
        </button>

      </div>
    </div>
  </div>
</header>

<script>
  const html     = document.documentElement;
  const langBtn  = document.getElementById('lang-toggle');
  const langLbl  = document.getElementById('lang-label');
  const themeBtn = document.getElementById('theme-toggle');

  const currentLang = (window as any).__lang || 'es';
  if (langLbl) langLbl.textContent = currentLang.toUpperCase();

  langBtn?.addEventListener('click', () => {
    const next = ((window as any).__lang || 'es') === 'es' ? 'en' : 'es';
    try { localStorage.setItem('lang', next); } catch (e) {}
    (window as any).__lang = next;
    html.lang = next;
    /* activa/desactiva clase CSS para bloques .lang-es/.lang-en */
    if (next === 'en') html.classList.add('lang-en');
    else html.classList.remove('lang-en');
    if (langLbl) langLbl.textContent = next.toUpperCase();
    if ((window as any).__applyTranslations) (window as any).__applyTranslations();
  });

  themeBtn?.addEventListener('click', () => {
    const isDark = html.classList.toggle('dark');
    try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch (e) {}
  });
</script>
