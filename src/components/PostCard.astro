---
import type { CollectionEntry } from 'astro:content';
import TagBadge from './TagBadge.astro';

interface Props {
  post:      CollectionEntry<'posts'>;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { title, title_en, description, description_en, pubDate, tags, author, heroImage } = post.data;

const dateStr  = pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' });
const dateISO  = pubDate.toISOString().slice(0, 10);
const readMin  = Math.ceil((post.body?.split(/\s+/).length ?? 200) / 200);
const href     = `/posts/${post.slug}`;
const imgSrc   = heroImage ?? `https://picsum.photos/seed/${post.slug}/800/450`;

// Build searchable text blob (includes both languages so search works in either)
const searchText = [title, title_en, description, description_en, ...tags]
  .filter(Boolean).join(' ').toLowerCase();
---

<article
  data-search-text={searchText}
  data-post-tags={tags.join(',')}
  class="group bg-white dark:bg-zinc-900/50
                border border-gray-200 dark:border-zinc-800 rounded-2xl overflow-hidden
                shadow-sm hover:shadow-lg dark:shadow-none
                hover:border-green-300 dark:hover:border-terminal-green/40
                transition-all duration-300">

  <!-- Image -->
  <a href={href} class="block overflow-hidden" tabindex="-1" aria-hidden="true">
    <img
      src={imgSrc}
      alt=""
      width="800" height="450"
      loading="lazy"
      decoding="async"
      class="w-full object-cover transition-transform duration-500 group-hover:scale-105"
      style="aspect-ratio:16/9;"
    />
  </a>

  <!-- Content -->
  <div class={`p-5 ${featured ? 'sm:p-7' : ''}`}>

    <!-- Meta -->
    <div class="flex items-center gap-3 text-xs text-gray-400 dark:text-zinc-500 mb-3 font-mono">
      <time datetime={dateISO} data-fmt-date={dateISO}>{dateStr}</time>
      <span aria-hidden="true">·</span>
      <span>
        {readMin}&thinsp;<span data-t="post.minread">min de lectura</span>
      </span>
      <span aria-hidden="true">·</span>
      <span>{author}</span>
    </div>

    <!-- Title (bilingual swap) -->
    <h2 class={`font-display font-semibold text-gray-900 dark:text-zinc-50 group-hover:text-green-700 dark:group-hover:text-terminal-green transition-colors mb-2 leading-snug ${featured ? 'text-2xl' : 'text-xl'}`}>
      <a href={href}
         data-text-es={title}
         data-text-en={title_en ?? title}>
        {title}
      </a>
    </h2>

    <!-- Description (bilingual swap) -->
    <p class="text-gray-500 dark:text-zinc-400 text-base leading-relaxed line-clamp-2 mb-4"
       data-text-es={description}
       data-text-en={description_en ?? description}>
      {description}
    </p>

    <!-- Footer row -->
    <div class="flex items-center justify-between gap-2 flex-wrap">
      <div class="flex flex-wrap gap-1.5">
        {tags.slice(0, 3).map(tag => <TagBadge tag={tag} linked />)}
      </div>
      <a href={href}
         class="text-sm font-semibold text-green-700 dark:text-terminal-green
                hover:text-green-800 dark:hover:text-terminal-green-dim
                flex items-center gap-1 transition-colors flex-shrink-0">
        <span data-t="post.readmore">Leer más</span>
        <span aria-hidden="true" class="group-hover:translate-x-0.5 transition-transform inline-block">→</span>
      </a>
    </div>

  </div>
</article>
